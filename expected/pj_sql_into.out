 psi_casevar | psi_casevar 
-------------+-------------
 2           | 3
(1 row)

SELECT psi_casevar(3);
 psi_casevar 
-------------
 4
(1 row)

SELECT psi_casevar2(1), psi_casevar2(2);
 psi_casevar2 | psi_casevar2 
--------------+--------------
 1            | 2
(1 row)

SELECT psi_casevar2(1), psi_casevar2(2);
 psi_casevar2 | psi_casevar2 
--------------+--------------
 1            | 2
(1 row)

SELECT psi_casevar2(3);
 psi_casevar2 
--------------
 3
(1 row)

