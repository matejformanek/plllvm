-- the variable of a simple CASE is named __Case__Variable_N__ in the block
-- after the CASE, and a statement may take it as a target (N is the number of
-- its datum): the function is declined, for an INTO of several targets and for
-- an assignment, as for one target (the function does not read it, which
-- would decline it as well)
CREATE FUNCTION psi_casevar(n int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE y int; z int;
BEGIN
  CASE n WHEN 1 THEN NULL; ELSE NULL; END CASE;
  SELECT n, n + 1 INTO "__Case__Variable_4__", y FROM psi_one;
  RETURN y::text;
END $$;
CREATE FUNCTION psi_casevar2(n int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE y int; z int;
BEGIN
  CASE n WHEN 1 THEN NULL; ELSE NULL; END CASE;
  "__Case__Variable_4__" := n + 5;
  RETURN n::text;
END $$;
SELECT psi_casevar(1), psi_casevar(2);
 psi_casevar | psi_casevar 
-------------+-------------
 2           | 3
(1 row)

