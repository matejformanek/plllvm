-- recursion through a statement: the frames are each their own
CREATE FUNCTION psi_recur(n int) RETURNS int LANGUAGE :pj_lang STABLE AS $$
DECLARE r int := 0;
BEGIN
  IF n > 0 THEN
    SELECT psi_recur(n - 1) INTO r FROM psi_one;
  END IF;
  RETURN n + r;
END $$;
SELECT psi_recur(3), psi_recur(4);
 psi_recur | psi_recur 
-----------+-----------
