-- STRICT is strict with or without the check, and a warning keeps the row
CREATE FUNCTION psi_xc2(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE x int;
BEGIN
  SELECT a INTO x FROM psi_t WHERE a > n ORDER BY a DESC;
  RETURN x;
END $$;
