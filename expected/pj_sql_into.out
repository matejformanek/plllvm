RESET plan_cache_mode;
-- a result of more than 64 columns: the arrays that hold the row are the
-- statement's, and memory read inside the loop does not grow
DO $$
BEGIN
  EXECUTE 'CREATE TABLE psi_wide AS SELECT 1 AS c1, ' ||
    (SELECT string_agg('2 AS c' || i, ', ') FROM generate_series(2, 70) i);
END $$;
CREATE FUNCTION psi_wide_loop(n int, probe int) RETURNS bigint LANGUAGE :pj_lang AS $$
DECLARE m bigint := 0; x int; y int;
BEGIN
  FOR i IN 1..n LOOP
    SELECT c1, c2 INTO x, y FROM psi_wide;
    SELECT * INTO x, y FROM psi_wide;
    IF i = probe THEN m := psi_mem(); END IF;
  END LOOP;
  RETURN m + x + y;
END $$;
SELECT psi_wide_loop(3, 1) > 0, psi_wide_loop(3, 2) > 0;
