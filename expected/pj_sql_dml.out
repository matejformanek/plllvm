CREATE FUNCTION psd_trunc(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE c int;
BEGIN
  INSERT INTO psd_tt VALUES (n, 'x');
  UPDATE psd_tt SET b = 'y' WHERE a = n RETURNING a INTO c;
  RETURN c;
END $$;
