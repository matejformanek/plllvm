(1 row)

SELECT pj_expect('psd_found(integer)', 'compiled') \gset
-- a function that is not VOLATILE may not write: SPI's error, the table unchanged
CREATE FUNCTION psd_stable(n int) RETURNS int LANGUAGE :pj_lang STABLE AS $$
BEGIN
  INSERT INTO psd_t VALUES (n, 'stable', 0);
  RETURN n;
END $$;
SELECT psd_try('SELECT psd_stable(50)');
                            psd_try                            
---------------------------------------------------------------
 0A000 INSERT is not allowed in a non-volatile function       +
                                                              +
                                                              +
 SQL statement "INSERT INTO psd_t VALUES (n, 'stable', 0)"    +
 PL/pgSQL function psd_stable(integer) line 3 at SQL statement+
 SQL statement "SELECT psd_stable(50)"                        +
 PL/pgSQL function psd_try(text) line 4 at EXECUTE
(1 row)

