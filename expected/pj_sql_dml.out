(1 row)

SELECT psd_found(12);
              psd_found               
--------------------------------------
 truetruefalsetruefalsefalsefalsetrue
(1 row)

:dt;
                                psd_t                                
---------------------------------------------------------------------
 (1,row1,1) (2,row2,302) (3,row3,3) (4,row4,4) (5,row5,5) (6,row6,6)
(1 row)

SELECT psd_found(13);
              psd_found               
--------------------------------------
 truetruefalsetruefalsefalsefalsetrue
(1 row)

:dt;
