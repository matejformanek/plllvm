-- INT_MIN / -1, INT_MIN % -1, -INT_MIN
CREATE FUNCTION eb_edge4() RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  m int := -2147483648;
  k int := -1;
  a int;
  b int;
  r text := '';
BEGIN
  FOR j IN 1..3 LOOP
    b := m % k;
    r := r || b || ',';
  END LOOP;
  BEGIN
    FOR j IN 1..3 LOOP
      a := m / k;
    END LOOP;
  EXCEPTION WHEN numeric_value_out_of_range THEN
    r := r || 'div:' || SQLERRM || ',';
  END;
  BEGIN
    FOR j IN 1..3 LOOP
      a := -m;
    END LOOP;
  EXCEPTION WHEN numeric_value_out_of_range THEN
    r := r || 'um:' || SQLERRM;
  END;
  RETURN r;
END
$$;
SELECT eb_edge4();
                        eb_edge4                        
--------------------------------------------------------
 0,0,0,div:integer out of range,um:integer out of range
(1 row)

-- NaN sorts above everything and equals itself; -0 = 0
CREATE FUNCTION eb_fnan() RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  x float8 := 'NaN';
  y float8 := 1;
  z float8 := '-0';
  r text := '';
  b1 bool;
  b2 bool;
  b3 bool;
  b4 bool;
  b5 bool;
  q float8;
  w float8;
BEGIN
  FOR j IN 1..3 LOOP
    b1 := x > y;
    b2 := x = x;
    b3 := x < y;
    b4 := z = 0;
    b5 := x <> x;
    q := x / 0;
    w := x + 1;
    r := r || b1 || b2 || b3 || b4 || b5 || q || w || ' ';
  END LOOP;
  RETURN r;
END
$$;
SELECT eb_fnan();
                                         eb_fnan                                         
-----------------------------------------------------------------------------------------
 truetruefalsetruefalseNaNNaN truetruefalsetruefalseNaNNaN truetruefalsetruefalseNaNNaN 
(1 row)

-- NULLs in arithmetic, comparisons and WHILE
CREATE FUNCTION eb_nulls(a int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  i int := a;
  s bigint := 10;
  r text := '';
  f float8;
  c int := 0;
  t1 int;
  t2 bigint;
  t3 float8;
  b bool;
BEGIN
  FOR j IN 1..3 LOOP
    t1 := i + 1;
    t2 := s + i;
    t3 := f * 2;
    b := i > 0;
    r := r || coalesce(t1::text, 'N') || coalesce(t2::text, 'N')
           || coalesce(t3::text, 'N') || coalesce(b::text, 'N') || ' ';
    IF i > 0 THEN
      r := r || 'T';
    ELSE
      r := r || 'F';
    END IF;
    WHILE i < 3 LOOP
      i := i + 1;
      c := c + 1;
      EXIT WHEN c > 10;
    END LOOP;
  END LOOP;
  RETURN r || c;
END
$$;
SELECT eb_nulls(1), eb_nulls(NULL), eb_nulls(-2);
            eb_nulls             |      eb_nulls       |             eb_nulls             
---------------------------------+---------------------+----------------------------------
 211Ntrue T413Ntrue T413Ntrue T2 | NNNN FNNNN FNNNN F0 | -18Nfalse F413Ntrue T413Ntrue T5
(1 row)

-- all arguments are evaluated before the strict NULL test, so x NULL does
-- not hide the division by zero in y / z
CREATE FUNCTION eb_strict(x int, y int, z int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  w int;
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    w := CASE k WHEN 3 THEN z ELSE 1 END;
    r := x + y / w;
  END LOOP;
  RETURN r;
END
$$;
SELECT eb_strict(NULL, 1, 1), eb_strict(1, NULL, 0), eb_strict(2, 6, 3);
 eb_strict | eb_strict | eb_strict 
-----------+-----------+-----------
           |           |         4
(1 row)

SELECT eb_strict(NULL, 1, 0);
ERROR:  division by zero
CONTEXT:  PL/pgSQL function eb_strict(integer,integer,integer) line 8 at assignment
-- an error caught by EXCEPTION, then the same expression again
CREATE FUNCTION eb_caught() RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  i int := 2147483640;
  r text := '';
  n int := 0;
BEGIN
  FOR j IN 1..20 LOOP
    BEGIN
      i := i + 1;
    EXCEPTION WHEN numeric_value_out_of_range THEN
      n := n + 1;
      i := 0;
    END;
  END LOOP;
  RETURN i || ' ' || n;
END
$$;
SELECT eb_caught();
 eb_caught 
-----------
 12 1
(1 row)

SELECT eb_caught();
 eb_caught 
-----------
 12 1
(1 row)

-- recursion: the outer expression is in use, inner calls go through SPI
CREATE FUNCTION eb_fib(n int) RETURNS int LANGUAGE plpgsql AS $$
BEGIN
  IF n < 2 THEN
    RETURN n;
  END IF;
  RETURN eb_fib(n - 1) + eb_fib(n - 2);
END
$$;
SELECT eb_fib(15);
 eb_fib 
--------
    610
(1 row)

-- a procedure with COMMIT: new ExprStates in every transaction
CREATE PROCEDURE eb_inc_proc(n int, c bool, INOUT r int DEFAULT 0)
LANGUAGE plpgsql AS $$
DECLARE
  i int := 0;
BEGIN
  WHILE i < n LOOP
    i := i + 1;
    IF c THEN
      COMMIT;
    END IF;
  END LOOP;
  r := i;
END
$$;
CALL eb_inc_proc(50, true);
 r  
----
 50
(1 row)

CALL eb_inc_proc(50, false);
 r  
----
 50
(1 row)

-- an inlined SQL function replaced inside a transaction: replanned
CREATE FUNCTION eb_addk(x int) RETURNS int LANGUAGE sql IMMUTABLE
AS $$ SELECT x + 1 $$;
CREATE FUNCTION eb_use_addk(n int) RETURNS int LANGUAGE plpgsql AS $$
DECLARE
  s int := 0;
BEGIN
  FOR i IN 1..n LOOP
    s := eb_addk(s);
  END LOOP;
  RETURN s;
END
$$;
BEGIN;
SELECT eb_use_addk(10);
 eb_use_addk 
-------------
          10
(1 row)

CREATE OR REPLACE FUNCTION eb_addk(x int) RETURNS int LANGUAGE sql IMMUTABLE
AS $$ SELECT x + 2 $$;
SELECT eb_use_addk(10);
 eb_use_addk 
-------------
          20
(1 row)

COMMIT;
SELECT eb_use_addk(10);
 eb_use_addk 
-------------
          20
(1 row)

-- shapes outside T0: int2, numeric, a record field, CASE, AND, a domain
-- with a CHECK
CREATE DOMAIN eb_posint AS int CHECK (VALUE > 0);
CREATE TYPE eb_pair AS (x int, y int);
CREATE FUNCTION eb_mixed(n int) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
  s2 int2 := 0;
  nm numeric := 0;
  t text := '';
  r eb_pair := ROW(1, 2);
  k int := 0;
  d eb_posint := 5;
  s int := 0;
BEGIN
  FOR i IN 1..n LOOP
    s2 := s2 + 1;
    nm := nm + 0.5;
    r.x := r.x + 1;
    k := CASE WHEN i % 2 = 0 THEN k + 1 ELSE k END;
    IF i > 1 AND k / i >= 0 THEN
      s := s + 1;
    END IF;
    s := s + abs(i - 3);
  END LOOP;
  t := s2 || ' ' || nm || ' ' || r.x || ' ' || k || ' ' || s;
  BEGIN
    LOOP
      d := d - 1;
    END LOOP;
  EXCEPTION WHEN check_violation THEN
    t := t || ' dom:' || SQLERRM || ' d=' || d;
  END;
  RETURN t;
END
$$;
SELECT eb_mixed(20);
                                             eb_mixed                                             
--------------------------------------------------------------------------------------------------
 20 10.0 21 10 175 dom:value for domain eb_posint violates check constraint "eb_posint_check" d=1
(1 row)

-- a trigger: TG_NARGS is a PROMISE datum
CREATE TABLE eb_tt (a int);
CREATE FUNCTION eb_trg() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  k int := 0;
BEGIN
  FOR i IN 1..3 LOOP
    k := k + TG_NARGS + i;
  END LOOP;
  NEW.a := NEW.a + k;
  RETURN NEW;
END
$$;
CREATE TRIGGER eb_tt_trg BEFORE INSERT ON eb_tt
  FOR EACH ROW EXECUTE FUNCTION eb_trg('x', 'y');
INSERT INTO eb_tt VALUES (1), (2), (3) RETURNING a;
 a  
----
 13
 14
 15
(3 rows)

-- a query and a simple expression in every iteration
CREATE TABLE eb_kv (id int PRIMARY KEY, v int);
INSERT INTO eb_kv SELECT g, g % 7 FROM generate_series(1, 2000) g;
ANALYZE eb_kv;
CREATE FUNCTION eb_glue(n int) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE
  s bigint := 0;
  r int;
BEGIN
  FOR i IN 1..n LOOP
    SELECT v INTO r FROM eb_kv WHERE id = i;
    s := s + r;
  END LOOP;
  RETURN s;
END
$$;
SELECT eb_glue(2000);
 eb_glue 
---------
    6000
(1 row)

-- DO blocks have their own simple-expression EState
DO $$
DECLARE
  i int := 0;
  s bigint := 0;
BEGIN
  WHILE i < 500 LOOP
    i := i + 1;
    s := s + i * i;
  END LOOP;
  RAISE NOTICE 'do: % %', i, s;
END
$$;
