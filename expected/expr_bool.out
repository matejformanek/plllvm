  ('mixed', 'a > b OR a / b > 0', 'bool'),
  ('float', 'sqrt(a)', 'float8'),
  ('float', '|/ a', 'float8'),
  ('float', 'dsqrt(a)', 'float8'),
  ('float', 'sqrt(a) * b', 'float8'),
