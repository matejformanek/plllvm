  ('int', 'CASE a WHEN 1 THEN 10 WHEN 2 THEN 20 ELSE 0 END', 'int4'),
  ('int', 'CASE a WHEN 0 THEN 0 WHEN 10 / a THEN 1 ELSE 2 END', 'int4'),
