--
-- The LLJIT runtime, through plllvm_jit_test()
--
LOAD 'plllvm';
SET plllvm.regress_test_mode = on;
\pset null '(null)'
-- an empty body
SELECT * FROM plllvm_jit_test('define i64 @f(ptr %fcinfo) { ret i64 0 }', 2);
 ok | sqlstate | message | detail |  line  |  col   | gen | ir_instructions | helpers_linked | cfi_left | checks_inserted 
----+----------+---------+--------+--------+--------+-----+-----------------+----------------+----------+-----------------
 t  | (null)   | (null)  | (null) | (null) | (null) |   1 |               1 |              0 |        0 |               0
(1 row)

SELECT owner_oid, symbol, gen, opt_level, ir_instructions, helpers_linked,
       cfi_left, retired,
       parse_bc_ms >= 0 AND parse_ms >= 0 AND link_ms >= 0 AND verify_ms >= 0
         AND optimize_ms >= 0 AND emit_ms > 0 AS timed,
       total_ms >= emit_ms AS total,
       code_addr IS NOT NULL AS addr
  FROM plllvm_code_cache();
 owner_oid |   symbol   | gen | opt_level | ir_instructions | helpers_linked | cfi_left | retired | timed | total | addr 
-----------+------------+-----+-----------+-----------------+----------------+----------+---------+-------+-------+------
 (null)    | plllvm_0_1 |   1 |         2 |               1 |              0 |        0 | t       | t     | t     | t
(1 row)

-- every host API symbol, declared and called; all resolve at lookup
CREATE TEMP TABLE ir (name text PRIMARY KEY, body text);
INSERT INTO ir VALUES ('host_api', $ir$
declare zeroext i1 @plllvm_arg_isnull(ptr, i32)
declare i32 @plllvm_arg_i32(ptr, i32)
declare i64 @plllvm_arg_i64(ptr, i32)
declare double @plllvm_arg_f64(ptr, i32)
declare zeroext i1 @plllvm_arg_bool(ptr, i32)
declare i32 @plllvm_nargs(ptr)
declare i64 @plllvm_return_null(ptr)
declare void @plllvm_cfi()
declare void @plllvm_check_stack()
declare void @plllvm_error(i32, ptr)
declare void @plllvm_notice(ptr)
declare void @plllvm_rt_int_overflow()
declare void @plllvm_rt_bigint_overflow()
declare void @plllvm_rt_div_zero()
declare void @float_overflow_error()
declare void @float_underflow_error()
declare void @float_zero_divide_error()

@msg = private constant [3 x i8] c"hi\00"

define i64 @f(ptr %p) {
entry:
  call void @plllvm_cfi()
  call void @plllvm_check_stack()
  call void @plllvm_notice(ptr @msg)
  %n = call i32 @plllvm_nargs(ptr %p)
  %a = call i32 @plllvm_arg_i32(ptr %p, i32 0)
  %b = call i64 @plllvm_arg_i64(ptr %p, i32 1)
  %c = call double @plllvm_arg_f64(ptr %p, i32 2)
  %d = call i1 @plllvm_arg_bool(ptr %p, i32 3)
  %e = call i1 @plllvm_arg_isnull(ptr %p, i32 4)
  switch i32 %n, label %done [i32 1, label %e1
                              i32 2, label %e2
                              i32 3, label %e3
                              i32 4, label %e4
                              i32 5, label %e5
                              i32 6, label %e6
                              i32 7, label %e7]
e1:
  call void @plllvm_error(i32 %a, ptr @msg)
  unreachable
e2:
  call void @plllvm_rt_int_overflow()
  unreachable
e3:
  call void @plllvm_rt_bigint_overflow()
  unreachable
e4:
  call void @plllvm_rt_div_zero()
  unreachable
e5:
  call void @float_overflow_error()
  unreachable
e6:
  call void @float_underflow_error()
  unreachable
e7:
  call void @float_zero_divide_error()
  unreachable
done:
  %ai = sext i32 %a to i64
  %ci = fptosi double %c to i64
  %s = add i64 %ai, %b
  %t = add i64 %s, %ci
  %isnull = or i1 %d, %e
  br i1 %isnull, label %null, label %ret
null:
  %r = call i64 @plllvm_return_null(ptr %p)
  ret i64 %r
ret:
  ret i64 %t
}
$ir$);
SELECT t.ok, t.sqlstate, t.message, t.gen, t.helpers_linked, t.cfi_left
  FROM ir, plllvm_jit_test(body, 0) t WHERE name = 'host_api';
 ok | sqlstate | message | gen | helpers_linked | cfi_left 
----+----------+---------+-----+----------------+----------
 t  | (null)   | (null)  |   2 |              9 |        0
(1 row)

SELECT t.ok, t.sqlstate, t.message, t.gen, t.helpers_linked, t.cfi_left
  FROM ir, plllvm_jit_test(body, 2) t WHERE name = 'host_api';
 ok | sqlstate | message | gen | helpers_linked | cfi_left 
----+----------+---------+-----+----------------+----------
 t  | (null)   | (null)  |   3 |              9 |        0
(1 row)

SELECT t.ok, t.sqlstate, t.message, t.gen, t.helpers_linked, t.cfi_left
  FROM ir, plllvm_jit_test(body, codegen => false) t WHERE name = 'host_api';
 ok | sqlstate | message |  gen   | helpers_linked | cfi_left 
----+----------+---------+--------+----------------+----------
 t  | (null)   | (null)  | (null) |              9 |   (null)
(1 row)

-- a parse error carries its position
SELECT ok, sqlstate, line, col, gen FROM plllvm_jit_test($ir$define i64 @f(ptr %p) {
  ret i32 0
}$ir$);
 ok | sqlstate | line | col |  gen   
----+----------+------+-----+--------
 f  | 42601    |    2 |   7 | (null)
(1 row)

-- the entry point
SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('define i64 @g(ptr %p) { ret i64 0 }');
 ok | sqlstate |                  message                  | detail 
----+----------+-------------------------------------------+--------
 f  | 42P13    | IR does not define the entry function "f" | (null)
(1 row)

SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('declare i64 @f(ptr)');
 ok | sqlstate |                  message                  | detail 
----+----------+-------------------------------------------+--------
 f  | 42P13    | IR does not define the entry function "f" | (null)
(1 row)

SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('define i32 @f(ptr %p) { ret i32 0 }');
 ok | sqlstate |                message                |       detail        
----+----------+---------------------------------------+---------------------
 f  | 42P13    | entry function "f" has type i32 (ptr) | Expected i64 (ptr).
(1 row)

SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('define internal i64 @f(ptr %p) { ret i64 0 }');
 ok | sqlstate |                    message                    | detail 
----+----------+-----------------------------------------------+--------
 f  | 42P13    | entry function "f" must have external linkage | (null)
(1 row)

-- declarations are checked against the host API, definitions may not
-- take its names
SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
declare i64 @plllvm_arg_i32(ptr, i32)
define i64 @f(ptr %p) {
  %v = call i64 @plllvm_arg_i32(ptr %p, i32 0)
  ret i64 %v
}
$ir$);
 ok | sqlstate |                           message                           |                     detail                     
----+----------+-------------------------------------------------------------+------------------------------------------------
 f  | 42P13    | declaration of "plllvm_arg_i32" does not match the host API | Expected i32 (ptr, i32), found i64 (ptr, i32).
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
declare void @plllvm_nope()
define i64 @f(ptr %p) {
  call void @plllvm_nope()
  ret i64 0
}
$ir$);
 ok | sqlstate |                  message                   | detail 
----+----------+--------------------------------------------+--------
 f  | 42883    | host function "plllvm_nope" does not exist | (null)
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
define void @plllvm_x() { ret void }
define i64 @f(ptr %p) { ret i64 0 }
$ir$);
 ok | sqlstate |              message              |                                  detail                                   
----+----------+-----------------------------------+---------------------------------------------------------------------------
 f  | 42P13    | the IR must not define "plllvm_x" | Names starting with "plllvm_" and the names of the host API are reserved.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
define void @check_stack_depth() { ret void }
define i64 @f(ptr %p) { ret i64 0 }
$ir$);
 ok | sqlstate |                  message                   |                                  detail                                   
----+----------+--------------------------------------------+---------------------------------------------------------------------------
 f  | 42P13    | the IR must not define "check_stack_depth" | Names starting with "plllvm_" and the names of the host API are reserved.
(1 row)

-- only the entry point is visible to other modules, and nothing runs
-- before it: no static constructors, module asm, aliases or ifuncs
SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
@x = internal global i64 0
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init, ptr null }]
define internal void @init() {
  store i64 99, ptr @x
  ret void
}
define i64 @f(ptr %p) {
  %v = load i64, ptr @x
  ret i64 %v
}
$ir$, codegen => false);
 ok | sqlstate |                  message                   |                         detail                         
----+----------+--------------------------------------------+--------------------------------------------------------
 f  | 42P13    | the IR must not define "llvm.global_ctors" | PL/LLVM never runs static constructors or destructors.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
@llvm.foo = global i64 7
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |              message              |                       detail                       
----+----------+-----------------------------------+----------------------------------------------------
 f  | 42P13    | the IR must not define "llvm.foo" | Names starting with "llvm." are reserved for LLVM.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
define void @"llvm.foo"() { ret void }
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |              message              |                       detail                       
----+----------+-----------------------------------+----------------------------------------------------
 f  | 42P13    | the IR must not define "llvm.foo" | Names starting with "llvm." are reserved for LLVM.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
define void @llvm.trap() { ret void }
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |              message               |                       detail                       
----+----------+------------------------------------+----------------------------------------------------
 f  | 42P13    | the IR must not define "llvm.trap" | Names starting with "llvm." are reserved for LLVM.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
module asm ".globl _plllvm_x"
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |                       message                        | detail 
----+----------+------------------------------------------------------+--------
 f  | 42P13    | the IR must not contain module-level inline assembly | (null)
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
@plllvm_x = alias i64 (ptr), ptr @f
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |                 message                 |                       detail                        
----+----------+-----------------------------------------+-----------------------------------------------------
 f  | 42P13    | the IR must not define alias "plllvm_x" | Only functions and global variables can be defined.
(1 row)

SELECT ok, sqlstate, message, detail FROM plllvm_jit_test($ir$
@g = ifunc void (), ptr @resolve
define internal ptr @resolve() { ret ptr null }
define i64 @f(ptr %p) { ret i64 0 }
$ir$, codegen => false);
 ok | sqlstate |             message              |                       detail                        
----+----------+----------------------------------+-----------------------------------------------------
 f  | 42P13    | the IR must not define ifunc "g" | Only functions and global variables can be defined.
(1 row)

-- a symbol that neither the host API nor the server has
INSERT INTO ir VALUES ('nosym', $ir$
declare void @no_such_function()
define i64 @f(ptr %p) {
  call void @no_such_function()
  ret i64 0
}
$ir$);
SELECT t.ok, t.sqlstate, t.message
  FROM ir, plllvm_jit_test(body, codegen => false) t WHERE name = 'nosym';
 ok | sqlstate |               message               
----+----------+-------------------------------------
 f  | 42883    | undefined symbol "no_such_function"
(1 row)

SELECT t.ok, t.sqlstate, t.message
  FROM ir, plllvm_jit_test(body) t WHERE name = 'nosym';
 ok | sqlstate |               message               
----+----------+-------------------------------------
 f  | 42883    | undefined symbol "no_such_function"
(1 row)

-- invalid IR that parses
SELECT ok, sqlstate, message FROM plllvm_jit_test($ir$
define i64 @f(ptr %p) {
  %x = add i64 %y, 1
  %y = add i64 %x, 1
  ret i64 0
}
$ir$);
 ok | sqlstate |                       message                       
----+----------+-----------------------------------------------------
 f  | 42P13    | invalid IR: Instruction does not dominate all uses!
(1 row)

-- an error in code generation fails the compile and drops its module
SELECT ok, sqlstate, message
  FROM plllvm_jit_test('define i64 @f(ptr %p) { call void asm sideeffect "no_such_insn", ""() ret i64 0 }');
 ok | sqlstate |                                 message                                  
----+----------+--------------------------------------------------------------------------
 f  | XX000    | could not emit code: <inline asm>:1:2: unrecognized instruction mnemonic
(1 row)

-- the size limit
SET plllvm.max_ir_instructions = 1;
SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('define i64 @f(ptr %p) { %x = add i64 0, 1 ret i64 %x }');
 ok | sqlstate |                     message                     |             detail              
----+----------+-------------------------------------------------+---------------------------------
 f  | 54000    | PL/LLVM function body has too many instructions | 2 instructions, the limit is 1.
(1 row)

RESET plllvm.max_ir_instructions;
-- the optimization level
SELECT ok FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 0 }', 7);  -- fail
ERROR:  opt_level must be between 0 and 3
SELECT ok FROM plllvm_jit_test(NULL);  -- fail
ERROR:  ir and codegen must not be null
SET plllvm.opt_level = 0;
SELECT ok, gen FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 0 }');
 ok | gen 
----+-----
 t  |  17
(1 row)

SELECT gen, opt_level FROM plllvm_code_cache() LIMIT 1;
 gen | opt_level 
-----+-----------
  17 |         0
(1 row)

RESET plllvm.opt_level;
-- the resident cap; failed compiles and released code do not count
SELECT compiles - retired + 1 AS cap FROM plllvm_session_info() \gset
SET plllvm.max_resident_compiles = :cap;
SELECT ok FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 1 }');
 ok 
----
 t
(1 row)

SELECT ok FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i32 1 }');
 ok 
----
 f
(1 row)

SELECT ok FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 2 }');
 ok 
----
 t
(1 row)

CREATE FUNCTION jt_cap() RETURNS int8 LANGUAGE plllvm
AS $$ define i64 @f(ptr %fcinfo) { ret i64 0 } $$;
SELECT jt_cap();
 jt_cap 
--------
      0
(1 row)

SELECT ok, sqlstate, message, detail
  FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 3 }');
 ok | sqlstate |                       message                       |                detail                 
----+----------+-----------------------------------------------------+---------------------------------------
 f  | 53400    | too many compiled PL/LLVM functions in this session | Resident compiles: 1, the limit is 1.
(1 row)

RESET plllvm.max_resident_compiles;
DROP FUNCTION jt_cap();
SELECT ok, gen FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 3 }');
 ok | gen 
----+-----
 t  |  22
(1 row)

SELECT compiles, compile_failures, retired FROM plllvm_session_info();
 compiles | compile_failures | retired 
----------+------------------+---------
        8 |               14 |       7
(1 row)

SELECT count(*), count(DISTINCT symbol) AS symbols, count(DISTINCT code_addr) AS addrs,
       bool_or(retired) AS retired
  FROM plllvm_code_cache();
 count | symbols | addrs | retired 
-------+---------+-------+---------
     2 |       2 |     2 | t
(1 row)

-- the empty constructor list and llvm.used that opt leaves behind are fine
SELECT ok, sqlstate, message FROM plllvm_jit_test($ir$
@x = internal global i64 0
@llvm.global_ctors = appending global [0 x { i32, ptr, ptr }] zeroinitializer
@llvm.used = appending global [1 x ptr] [ptr @x]
define i64 @f(ptr %p) {
  %v = load i64, ptr @x
  ret i64 %v
}
$ir$);
 ok | sqlstate | message 
----+----------+---------
 t  | (null)   | (null)
(1 row)

-- interrupt and stack checks go where the IR lacks them: a poll on every
-- loop, also behind a polled block, also an irreducible or indirect one
SELECT ok, checks_inserted, helpers_linked FROM plllvm_jit_test($ir$
declare void @plllvm_cfi()
define i64 @f(ptr %p) {
entry:
  call void @plllvm_cfi()
  br label %spin
spin:
  br label %spin
}
$ir$);
 ok | checks_inserted | helpers_linked 
----+-----------------+----------------
 t  |               1 |              1
(1 row)

SELECT ok, checks_inserted FROM plllvm_jit_test($ir$
define i64 @f(ptr %p) {
entry:
  %c = ptrtoint ptr %p to i64
  %t = trunc i64 %c to i1
  br i1 %t, label %a, label %b
a:
  br label %b
b:
  br label %a
}
$ir$);
 ok | checks_inserted 
----+-----------------
 t  |               1
(1 row)

SELECT ok, checks_inserted FROM plllvm_jit_test($ir$
define i64 @f(ptr %p) {
entry:
  br label %l
l:
  indirectbr ptr blockaddress(@f, %l), [label %l]
}
$ir$);
 ok | checks_inserted 
----+-----------------
 t  |               1
(1 row)

-- the kernels: clang's CHECK_FOR_INTERRUPTS() counts as a poll, fib's own
-- checks suffice
\getenv abs_srcdir PG_ABS_SRCDIR
\set nbody `cat :'abs_srcdir'/examples/kernels/nbody.ll`
\set revcomp `cat :'abs_srcdir'/examples/kernels/revcomp.ll`
\set fib `cat :'abs_srcdir'/examples/kernels/fib.ll`
SELECT ok, checks_inserted FROM plllvm_jit_test(:'nbody');
 ok | checks_inserted 
----+-----------------
 t  |               9
(1 row)

SELECT ok, checks_inserted FROM plllvm_jit_test(:'revcomp');
 ok | checks_inserted 
----+-----------------
 t  |               7
(1 row)

SELECT ok, checks_inserted FROM plllvm_jit_test(:'fib');
 ok | checks_inserted 
----+-----------------
 t  |               0
(1 row)

-- recursion gets them at the entry
SELECT ok, checks_inserted FROM plllvm_jit_test($ir$
define i64 @f(ptr %p) {
  %r = call i64 @f(ptr %p)
  ret i64 %r
}
$ir$);
 ok | checks_inserted 
----+-----------------
 t  |               2
(1 row)

-- off, for measurements
SET plllvm.auto_checks = off;
SELECT ok, checks_inserted FROM plllvm_jit_test(:'nbody');
 ok | checks_inserted 
----+-----------------
 t  |               0
(1 row)

RESET plllvm.auto_checks;
-- superuser only
CREATE ROLE regress_plllvm_jit;
SET ROLE regress_plllvm_jit;
SELECT ok FROM plllvm_jit_test('define i64 @f(ptr %p) { ret i64 0 }');  -- fail
ERROR:  permission denied for function plllvm_jit_test
SELECT count(*) FROM plllvm_code_cache();  -- fail
ERROR:  permission denied for function plllvm_code_cache
SET plllvm.debug_inject = 'llvm_fatal';  -- fail
ERROR:  permission denied to set parameter "plllvm.debug_inject"
RESET ROLE;
DROP ROLE regress_plllvm_jit;
DROP TABLE ir;
