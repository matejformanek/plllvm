BEGIN; SET ROLE regress_pj_r1; SELECT m1(-1) IS NULL AS m1a; RESET ROLE; REVOKE regress_pj_grp FROM regress_pj_r1; SET ROLE regress_pj_r1; SELECT m1(1) AS m1_denied; ROLLBACK;
