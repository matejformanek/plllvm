-- an error outside any expression marks none: NOT NULL, and the bounds of a FOR
CREATE FUNCTION pq_nn(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE v int NOT NULL := 0;
BEGIN
  v := NULLIF(n, 1) + 0;
  RETURN v;
END $$;
CREATE FUNCTION pq_fu(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE s int := 0;
BEGIN
  FOR i IN 1..NULLIF(n, 1) + 0 LOOP s := s + i; END LOOP;
  RETURN s;
END $$;
CREATE FUNCTION pq_fb(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE s int := 0;
BEGIN
  FOR i IN 1..3 BY n - 1 LOOP s := s + i; END LOOP;
  RETURN s;
END $$;
SELECT pq_nn(2), pq_nn(3), pq_nn(4), pq_fu(2), pq_fu(3), pq_fu(4), pq_fb(2), pq_fb(3), pq_fb(4);
