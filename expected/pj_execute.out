-- an error marks the expression it stops, and no other: PL/pgSQL builds the
-- rest as if there had been none.  A function with a marked expression is
-- PL/pgSQL's until the transaction ends, because its SPI path plans
-- differently
CREATE FUNCTION pq_a(p1 bigint, p2 int) RETURNS bigint LANGUAGE :pj_lang AS $$
BEGIN
  IF (- (NULL::smallint)) <> mod(p2, p2) THEN RETURN 0; END IF;
  p1 := p1 + 9223372036854775807;
  RETURN p1;
END $$;
SELECT pq_a(0, 1), pq_a(-1, 2), pq_a(0, 3);
