-- a cancel is the statement's, not an expression's: the function stays compiled
CREATE FUNCTION pq_to(n bigint) RETURNS bigint LANGUAGE :pj_lang AS $$
BEGIN
  LOOP EXIT WHEN n % 2 = 1; END LOOP;
  RETURN n;
END $$;
