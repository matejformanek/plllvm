-- PL/pgSQL's SPI path plans the assignment at every call: the first five
-- are custom plans, which a compiled call would not have counted
CREATE FUNCTION pq_f(p1 bigint) RETURNS bigint LANGUAGE :pj_lang AS $$
BEGIN
  p1 := (p1 - p1) + mod(3037000500, p1);
  RETURN p1;
END $$;
