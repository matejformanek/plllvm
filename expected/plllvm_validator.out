42P13
CREATE FUNCTION v_ir() RETURNS int8 LANGUAGE plllvm AS $$
define void @check_stack_depth() { ret void }
define i64 @f(ptr %fcinfo) { ret i64 0 }
$$;
ERROR:  the IR must not define "check_stack_depth"
DETAIL:  Names starting with "plllvm_" and the names of the host API are reserved.
CONTEXT:  compilation of PL/LLVM function "v_ir"
