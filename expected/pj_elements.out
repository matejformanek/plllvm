       pv_coalesce('{NULL,2,3}', 10);
 pv_coalesce | pv_coalesce | pv_coalesce 
-------------+-------------+-------------
           1 |           2 |        NULL
(1 row)

SELECT pv_and('{1,2,3}', 0), pv_or('{1,2,3}', 0), pv_case('{1,2,3}', 0),
       pv_coalesce('{1,2,3}', 0);
 pv_and | pv_or | pv_case | pv_coalesce 
--------+-------+---------+-------------
 f      | t     |      -1 |           1
(1 row)

