-- the value reads the array it is stored into
CREATE FUNCTION pv_self(a int4[], i int, j int) RETURNS int4[] LANGUAGE :pj_lang AS $$
BEGIN
  a[i] := a[j] + a[i];
  a[a[1]] := a[2];
  RETURN a;
END $$;
