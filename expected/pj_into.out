-- an error of the query has it in the context, then the line of the function
CREATE FUNCTION pi_err(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE a int;
BEGIN
  SELECT 100 / n INTO a;
  RETURN a;
END $$;
