-- the memory of a text target is flat inside one call, measured inside it.
-- The copy of a target is freed by the next assignment, so a leak of the
-- old copy would show here; one left until the end of the call would not
-- show after it.
CREATE FUNCTION pi_mem() RETURNS bigint LANGUAGE sql STABLE AS
  $$ SELECT sum(total_bytes)::bigint FROM pg_backend_memory_contexts $$;
CREATE FUNCTION pi_loop(n int) RETURNS bigint LANGUAGE :pj_lang AS $$
DECLARE t text; s int := 0; m0 bigint;
BEGIN
  FOR i IN 1..10 LOOP
    SELECT repeat('x', i % 50) INTO t;
    s := s + length(t);
  END LOOP;
  m0 := pi_mem();
  FOR i IN 1..n LOOP
    SELECT repeat('x', i % 50) INTO t;
    s := s + length(t);
  END LOOP;
  RETURN pi_mem() - m0;
END $$;
SELECT pi_loop(10) IS NOT NULL;
 ?column? 
----------
 t
(1 row)

SELECT pi_loop(10) IS NOT NULL;
 ?column? 
----------
 t
(1 row)

SELECT pi_loop(100000) < 1048576 AS flat;
 flat 
------
 t
(1 row)

SELECT pj_expect('pi_loop(integer)', 'compiled') \gset
-- and the values of the same loop: the old copy of the target is freed at
-- each assignment, and a read of it after that would change the length
CREATE FUNCTION pi_loop_sum(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE t text; s int := 0;
BEGIN
  FOR i IN 1..n LOOP
    SELECT repeat('x', i % 50) INTO t;
    s := s + length(t);
  END LOOP;
  RETURN s;
END $$;
SELECT pi_loop_sum(10), pi_loop_sum(10), pi_loop_sum(100000);
 pi_loop_sum | pi_loop_sum | pi_loop_sum 
-------------+-------------+-------------
          55 |          55 |     2450000
(1 row)

SELECT pj_expect('pi_loop_sum(integer)', 'compiled') \gset
DROP TABLE pi_t;
DROP OWNED BY regress_pj_i1;
DROP ROLE regress_pj_i1;
