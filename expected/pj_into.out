ERROR:  permission denied for function pi_secret
CONTEXT:  SQL statement "SELECT pi_secret(n)"
PL/pgSQL function pi_priv(integer) line 4 at SQL statement
SELECT pi_priv(7);  -- fail
ERROR:  permission denied for function pi_secret
CONTEXT:  SQL statement "SELECT pi_secret(n)"
PL/pgSQL function pi_priv(integer) line 4 at SQL statement
RESET ROLE;
