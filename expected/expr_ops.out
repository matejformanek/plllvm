    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := float8pl(e, f);
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e = f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e <> f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e < f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e <= f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e > f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e >= f;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := -e;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := -(e * f);
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := e * 0.5 + 1.0;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := (e - f) * (e + f);
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := e / 3.0;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := 2.0 / e;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE NULL END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := e / 0;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e >= 1.99;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := e < 0.0;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := (e < f) <> (f < e);
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rb := (e = f) = (e <> f);
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  RETURN rtrim(r);
END
$$;
CREATE FUNCTION expr_ops_bool(x0 bool, y0 bool) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
  p bool;
  q bool;
  n int;
  r text := '';
  ri int4; rl int8; rf float8; rb bool;
BEGIN
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      p := CASE k WHEN 3 THEN x0 ELSE true END;
      q := CASE k WHEN 3 THEN y0 ELSE true END;
      rb := p = q;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      p := CASE k WHEN 3 THEN x0 ELSE true END;
      q := CASE k WHEN 3 THEN y0 ELSE true END;
      rb := p <> q;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      p := CASE k WHEN 3 THEN x0 ELSE true END;
      q := CASE k WHEN 3 THEN y0 ELSE true END;
      rb := (p = q) = (q <> p);
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      p := CASE k WHEN 3 THEN x0 ELSE true END;
      q := CASE k WHEN 3 THEN y0 ELSE true END;
      rb := (p <> q) <> false;
    END LOOP;
    r := r || coalesce(rb::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  RETURN rtrim(r);
END
$$;
CREATE PROCEDURE expr_ops_run()
LANGUAGE plpgsql AS $$
DECLARE
  v_int4 int4[] := ARRAY[NULL, 0, 1, -1, 2, -2, 7, 2147483647, -2147483648,
    46341, 65536]::int4[];
  v_int8 int8[] := ARRAY[NULL, 0, 1, -1, 3, -9223372036854775808,
    9223372036854775807, 3037000500, 4294967296, 2147483648,
    -2147483649]::int8[];
  v_float8 float8[] := ARRAY[NULL, 0, '-0', 1, -1, 0.5, 1e308, -1e308, 1e-308,
    2.5e-308, 'NaN', 'Infinity', '-Infinity', 3]::float8[];
  v_bool bool[] := ARRAY[NULL, true, false]::bool[];
BEGIN
  FOR i IN 1..array_length(v_int4, 1) LOOP
    FOR j IN 1..array_length(v_int4, 1) LOOP
      INSERT INTO expr_ops_res (grp, x, y, r)
        VALUES ('i4', v_int4[i], v_int4[j],
                expr_ops_i4(v_int4[i], v_int4[j]));
      COMMIT;
    END LOOP;
  END LOOP;
  FOR i IN 1..array_length(v_int8, 1) LOOP
    FOR j IN 1..array_length(v_int8, 1) LOOP
      INSERT INTO expr_ops_res (grp, x, y, r)
        VALUES ('i8', v_int8[i], v_int8[j],
                expr_ops_i8(v_int8[i], v_int8[j]));
      COMMIT;
    END LOOP;
  END LOOP;
  FOR i IN 1..array_length(v_int4, 1) LOOP
    FOR j IN 1..array_length(v_int8, 1) LOOP
      INSERT INTO expr_ops_res (grp, x, y, r)
        VALUES ('i48', v_int4[i], v_int8[j],
                expr_ops_i48(v_int4[i], v_int8[j]));
      COMMIT;
    END LOOP;
  END LOOP;
  FOR i IN 1..array_length(v_float8, 1) LOOP
    FOR j IN 1..array_length(v_float8, 1) LOOP
      INSERT INTO expr_ops_res (grp, x, y, r)
        VALUES ('f8', v_float8[i], v_float8[j],
                expr_ops_f8(v_float8[i], v_float8[j]));
      COMMIT;
    END LOOP;
  END LOOP;
  FOR i IN 1..array_length(v_bool, 1) LOOP
    FOR j IN 1..array_length(v_bool, 1) LOOP
      INSERT INTO expr_ops_res (grp, x, y, r)
        VALUES ('bool', v_bool[i], v_bool[j],
                expr_ops_bool(v_bool[i], v_bool[j]));
      COMMIT;
    END LOOP;
  END LOOP;
END
$$;
-- installed (compiled or from the cache) before the run
CREATE TEMP TABLE expr_ops_before AS
  SELECT installed FROM plllvm_expr_stats();
CALL expr_ops_run();
-- with plllvm.expr_jit on, every case but 1 got code in every row
SELECT NOT coalesce(current_setting('plllvm.expr_jit', true), 'off')::bool
       OR s.installed - b.installed = 15238 AS all_installed
  FROM plllvm_expr_stats() s, expr_ops_before b;
 all_installed 
