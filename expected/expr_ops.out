-- what the cases raised
SELECT grp, count(*) AS cases,
       count(*) FILTER (WHERE t = 'E22003') AS out_of_range,
       count(*) FILTER (WHERE t = 'E22012') AS division_by_zero,
       count(*) FILTER (WHERE t LIKE 'E%') AS errors,
       count(*) FILTER (WHERE t = 'N') AS nulls,
       count(*) FILTER (WHERE t = 'B') AS harmless_failed
  FROM expr_ops_res, regexp_split_to_table(r, ' ') t
 GROUP BY ROLLUP (grp) ORDER BY grp;
