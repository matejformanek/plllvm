CREATE FUNCTION expr_ops_f8(x0 float8, y0 float8) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
  e float8;
  f float8;
  n int;
  r text := '';
  ri int4; rl int8; rf float8; rb bool;
BEGIN
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := e + f;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
