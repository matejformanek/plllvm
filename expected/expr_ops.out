  EXCEPTION WHEN OTHERS THEN
    r := r || CASE WHEN n < 3 THEN 'B' ELSE 'E' || SQLSTATE END || ' ';
  END;
  BEGIN
    FOR k IN 1..3 LOOP
      n := k;
      e := CASE k WHEN 3 THEN x0 ELSE 1 END;
      f := CASE k WHEN 3 THEN y0 ELSE 1 END;
      rf := e * f;
    END LOOP;
    r := r || coalesce(rf::text, 'N') || ' ';
  EXCEPTION WHEN OTHERS THEN
