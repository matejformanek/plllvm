--
-- expr_collide: expressions whose serialisations share a prefix, so that
-- they may share a hash bucket of the expression cache; each must still
-- get its own program
--
-- The expected output is stock PL/pgSQL's, and make installcheck-expr
-- compares every variant against it; the plllvm check runs only where
-- plllvm is loaded, and prints nothing.  Every function evaluates its
-- expression three times per call.  Each list runs twice (the second time
-- from the cache), then again in a new session with the other function of
-- each pair first.
--
-- Consts that differ only in value
CREATE FUNCTION ec_p1a(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + 1;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p1b(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + 2;
  END LOOP;
  RETURN r;
END
$$;
-- the same operator, the Params swapped
CREATE FUNCTION ec_p2a(x int, y int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x - y;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p2b(x int, y int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := y - x;
  END LOOP;
  RETURN r;
END
$$;
-- the same nodes in another tree
CREATE FUNCTION ec_p3a(x int, y int, z int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := (x + y) * z;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p3b(x int, y int, z int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + y * z;
  END LOOP;
  RETURN r;
END
$$;
-- an int4 and an int8 Param at the same paramid
CREATE FUNCTION ec_p4a(x int, y int) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
  r bigint;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + y;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p4b(x bigint, y int) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
  r bigint;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + y;
  END LOOP;
  RETURN r;
END
$$;
-- the same text, the variables declared in the other order
CREATE FUNCTION ec_p5a(x int, y int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x - y;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p5b(y int, x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x - y;
  END LOOP;
  RETURN r;
END
$$;
-- float8, the Params swapped
CREATE FUNCTION ec_p6a(e float8, f float8) RETURNS float8
LANGUAGE plpgsql AS $$
DECLARE
  r float8;
BEGIN
  FOR k IN 1..3 LOOP
    r := e / f;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p6b(e float8, f float8) RETURNS float8
LANGUAGE plpgsql AS $$
DECLARE
  r float8;
BEGIN
  FOR k IN 1..3 LOOP
    r := f / e;
  END LOOP;
  RETURN r;
END
$$;
-- neighbouring comparisons
CREATE FUNCTION ec_p7a(x int, y int) RETURNS bool
LANGUAGE plpgsql AS $$
DECLARE
  r bool;
BEGIN
  FOR k IN 1..3 LOOP
    r := x < y;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p7b(x int, y int) RETURNS bool
LANGUAGE plpgsql AS $$
DECLARE
  r bool;
BEGIN
  FOR k IN 1..3 LOOP
    r := x <= y;
  END LOOP;
  RETURN r;
END
$$;
-- an int4 and an int8 Const
CREATE FUNCTION ec_p8a(x bigint) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
  r bigint;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + 1;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p8b(x bigint) RETURNS bigint
LANGUAGE plpgsql AS $$
DECLARE
  r bigint;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + 1::bigint;
  END LOOP;
  RETURN r;
END
$$;
-- division and modulo
CREATE FUNCTION ec_p9a(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x / 3;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_p9b(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x % 3;
  END LOOP;
  RETURN r;
END
$$;
-- a first
SELECT 'p1' AS pair, '5' AS args,
       ec_p1a(5)::text AS a,
       ec_p1b(5)::text AS b
UNION ALL
SELECT 'p1' AS pair, '-1' AS args,
       ec_p1a(-1)::text AS a,
       ec_p1b(-1)::text AS b
UNION ALL
SELECT 'p2' AS pair, '7, 2' AS args,
       ec_p2a(7, 2)::text AS a,
       ec_p2b(7, 2)::text AS b
UNION ALL
