DO $do$
DECLARE
  t record;
BEGIN
  FOR t IN SELECT pair, params FROM ec_t1 LOOP
    EXECUTE format('DROP FUNCTION ec_%sa(%s), ec_%sb(%s)',
                   t.pair, t.params, t.pair, t.params);
  END LOOP;
END
$do$;
DROP FUNCTION ec_call(text, text);
DROP TABLE ec_t1, ec_t1_args;
