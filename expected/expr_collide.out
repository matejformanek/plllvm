DROP FUNCTION ec_p1a(int),
  ec_p1b(int),
  ec_p2a(int, int),
  ec_p2b(int, int),
  ec_p3a(int, int, int),
  ec_p3b(int, int, int),
  ec_p4a(int, int),
  ec_p4b(bigint, int),
  ec_p5a(int, int),
  ec_p5b(int, int),
  ec_p6a(float8, float8),
  ec_p6b(float8, float8),
  ec_p7a(int, int),
  ec_p7b(int, int),
  ec_p8a(bigint),
  ec_p8b(bigint),
  ec_p9a(int),
  ec_p9b(int);
-- Trees that differ only in what the key leaves out: an operator over
-- int4pl other than + differs from x + 12345 only in its OID.  Each
-- function must get its own program, not reuse the other's.
CREATE OPERATOR ### (LEFTARG = int, RIGHTARG = int, FUNCTION = int4pl);
CREATE FUNCTION ec_k1a(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x ### 12345;
  END LOOP;
  RETURN r;
END
$$;
CREATE FUNCTION ec_k1b(x int) RETURNS int
LANGUAGE plpgsql AS $$
DECLARE
  r int;
BEGIN
  FOR k IN 1..3 LOOP
    r := x + 12345;
  END LOOP;
  RETURN r;
END
$$;
DO $$
BEGIN
  IF current_setting('plllvm.expr_jit', true) IS NOT NULL THEN
    EXECUTE 'CREATE TEMP TABLE ec_before AS
               SELECT compiled, installed FROM plllvm_expr_stats()';
  END IF;
END
$$;
SELECT ec_k1a(1);
