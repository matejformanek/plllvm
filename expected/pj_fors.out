-- a FOR that no call has reached when the function is translated: the call
-- that reaches it goes back to PL/pgSQL, which plans it, and the next ones run
-- it compiled
CREATE FUNCTION pf_deopt(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE a int; s int := 0;
BEGIN
  IF n = 99 THEN FOR a IN SELECT g FROM generate_series(1, 5) g LOOP s := s + a; END LOOP;
  END IF; RETURN s + n;
END $$;
SELECT pf_w('SELECT pf_deopt(1), pf_deopt(2)') \gset
SELECT pj_expect('pf_deopt(integer)', 'compiled') \gset
SELECT pf_deopt(99);
 pf_deopt 
----------
      114
(1 row)

SELECT pj_expect('pf_deopt(integer)', 'deopt') \gset
SELECT pf_deopt(99), pf_deopt(1);
 pf_deopt | pf_deopt 
----------+----------
      114 |        1
(1 row)

