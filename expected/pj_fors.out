HINT:  Make sure the query returns the exact list of columns.
WARNING:  number of source and target fields in assignment does not match
DETAIL:  strict_multi_assignment check of extra_warnings is active.
HINT:  Make sure the query returns the exact list of columns.
 pf_try 
--------
 ok
(1 row)

SET plpgsql.extra_errors = 'strict_multi_assignment';
SELECT pf_try('SELECT pf_multi(3)'), pf_try('SELECT pf_multi(0)');
                                pf_try                                 | pf_try 
-----------------------------------------------------------------------+--------
 42804 number of source and target fields in assignment does not match+| ok
 PL/pgSQL function pf_multi(integer) line 4 at FOR over SELECT rows   +| 
 SQL statement "SELECT pf_multi(3)"                                   +| 
 PL/pgSQL function pf_try(text) line 4 at EXECUTE                      | 
(1 row)

SELECT pj_expect('pf_multi(integer)', 'compiled') \gset
-- A9b: with every check on, two columns into two targets are no error
SET plpgsql.extra_errors = 'all';
SET plpgsql.extra_warnings = 'all';
SELECT pf_w('SELECT pf_two(11)') \gset
SELECT pf_two(11);
 pf_two 
--------
 66
(1 row)

SELECT pj_expect('pf_two(integer)', 'compiled') \gset
RESET plpgsql.extra_errors;
RESET plpgsql.extra_warnings;
-- A11: 100000 rows, the text of the row read in the loop at row 1000 and at
-- the last (a by-reference value that is not in a batch that was freed), and
-- the batches are freed: the memory of the backend, which a STABLE function
-- reads, is the same before and after the loop; so it is after 3000 loops
-- that each leave a last batch and a batch change behind them
CREATE TABLE pf_bt (a int, b int) WITH (autovacuum_enabled = false);
INSERT INTO pf_bt SELECT g, g FROM generate_series(1, 100000) g;
ANALYZE pf_bt;
CREATE FUNCTION pf_mem() RETURNS bigint LANGUAGE plpgsql STABLE AS
  'BEGIN RETURN (SELECT sum(total_bytes) FROM pg_get_backend_memory_contexts()); END';
CREATE FUNCTION pf_big(n int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE t text; c int := 0; r text := ''; m0 bigint; m1 bigint;
BEGIN
  SELECT pf_mem() INTO m0;
  FOR t IN SELECT repeat('x', 100) || b FROM pf_bt WHERE a <= n LOOP c := c + 1;
  IF c = 1000 OR c = n THEN r := r || right(t, 6) || ','; END IF; END LOOP;
  SELECT pf_mem() INTO m1; RETURN r || c || ',' || (m1 - m0 < 8388608);
END $$;
CREATE FUNCTION pf_reopen(n int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE a int; t text; c int := 0; m0 bigint;
BEGIN
  SELECT pf_mem() INTO m0;
  FOR a IN SELECT g FROM generate_series(1, n) g LOOP FOR t IN SELECT repeat('y', 200) FROM generate_series(1, 25) g LOOP c := c + 1;
  END LOOP; END LOOP; RETURN c || ',' || (pf_mem() - m0 < 8388608);
END $$;
SELECT pf_w('SELECT pf_big(2000), pf_reopen(20)') \gset
SELECT pf_big(100000), pf_reopen(3000);
          pf_big           | pf_reopen  
---------------------------+------------
 xx1000,100000,100000,true | 75000,true
(1 row)

SELECT pj_expect('pf_big(integer)', 'compiled') \gset
SELECT pj_expect('pf_reopen(integer)', 'compiled') \gset
-- B2: the shapes that stay declined, with the reasons: a query that writes,
-- also in a CTE, and a record (EXECUTE and cursors are declined as before)
CREATE TABLE pf_log (n int);
CREATE FUNCTION pf_wr(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE a int; s int := 0;
BEGIN
  FOR a IN INSERT INTO pf_log SELECT g FROM generate_series(1, n) g RETURNING pf_log.n LOOP s := s + a;
  END LOOP; RETURN s;
END $$;
CREATE FUNCTION pf_wr2(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE a int; s int := 0;
BEGIN
  FOR a IN WITH d AS (INSERT INTO pf_log SELECT g FROM generate_series(1, n) g RETURNING pf_log.n) SELECT d.n FROM d LOOP s := s + a;
  END LOOP; RETURN s;
END $$;
CREATE FUNCTION pf_rcd(n int) RETURNS int LANGUAGE :pj_lang AS $$
DECLARE r record; s int := 0;
BEGIN
  FOR r IN SELECT g FROM generate_series(1, n) g LOOP s := s + 1; END LOOP; RETURN s;
END $$;
SELECT pf_w('SELECT pf_wr(3), pf_wr2(3), pf_rcd(3)') \gset
SELECT pf_wr(3), pf_wr2(3), pf_rcd(3);
 pf_wr | pf_wr2 | pf_rcd 
-------+--------+--------
     6 |      6 |      3
(1 row)

SELECT pj_expect('pf_wr(integer)', 'declined:fors:writes') \gset
SELECT pj_expect('pf_wr2(integer)', 'declined:fors:writes') \gset
SELECT pj_expect('pf_rcd(integer)', 'declined:datum:record') \gset
-- B3: TRUNCATE and ANALYZE between calls: the plan of the loop is stale and
-- runs; the function stays compiled, with no translation
CREATE TABLE pf_s (a int) WITH (autovacuum_enabled = false);
INSERT INTO pf_s SELECT g FROM generate_series(1, 30) g;
ANALYZE pf_s;
CREATE FUNCTION pf_stale() RETURNS int LANGUAGE :pj_lang AS $$
DECLARE a int; s int := 0;
BEGIN
  FOR a IN SELECT pf_s.a FROM pf_s LOOP s := s + a; END LOOP; RETURN s;
END $$;
SELECT pf_w('SELECT pf_stale()') \gset
SELECT pj_expect('pf_stale()', 'compiled') \gset
SELECT pj_mark() \gset
TRUNCATE pf_s;
INSERT INTO pf_s SELECT g FROM generate_series(1, 5) g;
ANALYZE pf_s;
SELECT pf_stale();
 pf_stale 
----------
       15
(1 row)

INSERT INTO pf_s SELECT g FROM generate_series(1, 5000) g;
ANALYZE pf_s;
CREATE INDEX ON pf_s (a);
SELECT pf_stale();
 pf_stale 
----------
 12502515
(1 row)

SELECT pj_delta(2, 0, NULL, 0, 0, NULL, 2, 0);
 pj_delta 
----------
 
(1 row)

-- B5: a column whose type changes after the function was admitted is
-- converted to the target for the call that finds the plan stale, which stays
-- compiled, also when that call returns from inside the loop with a value
-- made from a converted one; the next call finds that the result is not what
-- it was admitted with and translates again, and the one after finds the
-- function declined for the cast.  The same under pj_codegen boxed.
CREATE TABLE pf_c (a int, b int) WITH (autovacuum_enabled = false);
INSERT INTO pf_c SELECT g, g FROM generate_series(1, 12) g;
CREATE FUNCTION pf_conv() RETURNS text LANGUAGE :pj_lang AS $$
DECLARE x int; s int := 0;
BEGIN
  FOR x IN SELECT b FROM pf_c ORDER BY a LOOP s := s + x; END LOOP; RETURN s || '/' || x;
END $$;
CREATE FUNCTION pf_uaf(k int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE x int;
BEGIN
  FOR x IN SELECT b FROM pf_c ORDER BY a LOOP IF x = k THEN RETURN repeat('ab', 40) || x::text || 'end';
  END IF; END LOOP; RETURN 'none';
END $$;
SELECT pf_w('SELECT pf_conv(), pf_uaf(5), pf_uaf(100)') \gset
SELECT pj_expect('pf_conv()', 'compiled') \gset
ALTER TABLE pf_c ALTER COLUMN b TYPE text USING b::text;
SELECT pj_mark() \gset
SELECT pf_uaf(5);
                                        pf_uaf                                        
--------------------------------------------------------------------------------------
 abababababababababababababababababababababababababababababababababababababababab5end
(1 row)

SELECT pf_conv();
 pf_conv 
---------
 78/12
(1 row)

SELECT pj_delta(2, 0, NULL, 0, 0);
 pj_delta 
----------
 
(1 row)

SELECT pf_uaf(5), pf_conv();
                                        pf_uaf                                        | pf_conv 
--------------------------------------------------------------------------------------+---------
 abababababababababababababababababababababababababababababababababababababababab5end | 78/12
(1 row)

SELECT pj_expect('pf_conv()', 'interpreted:guard miss') \gset
SELECT pf_uaf(5), pf_conv();
                                        pf_uaf                                        | pf_conv 
--------------------------------------------------------------------------------------+---------
 abababababababababababababababababababababababababababababababababababababababab5end | 78/12
(1 row)

SELECT pj_expect('pf_conv()', 'declined:cast') \gset
SET plllvm.pj_codegen = boxed;
CREATE TABLE pf_e (a int, b int) WITH (autovacuum_enabled = false);
INSERT INTO pf_e SELECT g, g FROM generate_series(1, 12) g;
CREATE FUNCTION pf_uaf3(k int) RETURNS text LANGUAGE :pj_lang AS $$
DECLARE x int;
BEGIN
  FOR x IN SELECT b FROM pf_e ORDER BY a LOOP IF x = k THEN RETURN repeat('ef', 40) || x::text || 'end';
  END IF; END LOOP; RETURN 'none';
END $$;
SELECT pf_w('SELECT pf_uaf3(5), pf_uaf3(100)') \gset
SELECT pj_expect('pf_uaf3(integer)', 'compiled') \gset
ALTER TABLE pf_e ALTER COLUMN b TYPE text USING b::text;
SELECT pj_mark() \gset
SELECT pf_uaf3(5);
                                       pf_uaf3                                        
--------------------------------------------------------------------------------------
 efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef5end
(1 row)

SELECT pj_delta(1, 0, NULL, 0, 0);
 pj_delta 
----------
 
(1 row)

RESET plllvm.pj_codegen;
-- the memory that the conversions of a row allocate is released with the row
-- (the table of A11, its column now a text)
CREATE FUNCTION pf_conv3() RETURNS bigint LANGUAGE :pj_lang AS $$
DECLARE x int; s bigint := 0;
BEGIN
  FOR x IN SELECT b FROM pf_bt LOOP s := s + x; END LOOP; RETURN s;
END $$;
CREATE FUNCTION pf_peak() RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE p bigint := 0;
BEGIN
  IF current_setting('plllvm.plpgsql_jit', true) IS NOT NULL AND current_setting('debug_discard_caches')::int = 0 THEN EXECUTE 'SELECT peak_tuple_bytes FROM plllvm_pj_stats()' INTO p;
  END IF; RETURN p;
END $$;
SELECT pf_w('SELECT pf_conv3()') \gset
ALTER TABLE pf_bt ALTER COLUMN b TYPE text USING b::text;
SELECT pf_conv3();
  pf_conv3  
------------
